/* ============================================================
   ROS GUI启动器 - Fluent Dark 主题
   设计参考: PyQt-Fluent-Widgets (★8k) + QDarkStyleSheet (★3.1k)
   配色: 深灰底 + 白色半透明叠加 + 蓝色强调
   ============================================================ */
* {
    font-family: "Segoe UI", "Noto Sans CJK SC", "WenQuanYi Micro Hei", sans-serif;
    font-size: 13px;
    outline: none;
}
QMainWindow, QWidget {
    background-color: #202020;
    color: #ffffff;
    font-size: 13px;
}
/* ---- 卡片 ---- */
QGroupBox {
    background-color: #272727;
    border: 1px solid #3c3c3c;
    border-radius: 10px;
    margin-top: 16px;
    padding-top: 12px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 10px;
    color: #60cdff;
    background-color: #272727;
    border-radius: 6px;
}
/* ---- 按钮 ---- */
QPushButton {
    background-color: #333333;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 7px 16px;
    color: #ffffff;
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #555555;
}
QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}
QPushButton:disabled {
    background-color: #2b2b2b;
    color: #6b6b6b;
    border-color: #333333;
}
/* 启动/停止按钮 */
QPushButton#btnStart {
    background-color: #2e7d32;
    border: none;
    border-radius: 6px;
    padding: 5px 16px;
    color: #ffffff;
    font-weight: bold;
}
QPushButton#btnStart:hover { background-color: #43a047; }
QPushButton#btnStart:pressed { background-color: #2e7d32; }
QPushButton#btnStop {
    background-color: #c62828;
    border: none;
    border-radius: 6px;
    padding: 5px 16px;
    color: #ffffff;
    font-weight: bold;
}
QPushButton#btnStop:hover { background-color: #e53935; }
QPushButton#btnStop:pressed { background-color: #c62828; }
/* 全局启动/停止 */
QPushButton#btnGlobalStart {
    background-color: #2e7d32;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 32px;
    color: #ffffff;
}
QPushButton#btnGlobalStart:hover { background-color: #43a047; }
QPushButton#btnGlobalStart:pressed { background-color: #388e3c; }
QPushButton#btnGlobalStop {
    background-color: #c62828;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 32px;
    color: #ffffff;
}
QPushButton#btnGlobalStop:hover { background-color: #e53935; }
QPushButton#btnGlobalStop:pressed { background-color: #d32f2f; }
/* ---- 输入框 ---- */
QLineEdit {
    background-color: #2b2b2b;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 7px 10px;
    color: #ffffff;
    selection-background-color: #60cdff;
    selection-color: #202020;
}
QLineEdit:hover { border-color: #555555; }
QLineEdit:focus {
    border-color: #60cdff;
    background-color: #303030;
}
QSpinBox {
    background-color: #2b2b2b;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 5px 8px;
    color: #ffffff;
}
QSpinBox:focus { border-color: #60cdff; }
/* ---- 表格 ---- */
QTableWidget {
    background-color: #242424;
    alternate-background-color: #282828;
    gridline-color: #333333;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    selection-background-color: #60cdff;
    selection-color: #202020;
}
QTableWidget::item {
    padding: 6px;
    border: none;
    border-bottom: 1px solid #2d2d2d;
}
QTableWidget::item:selected {
    background-color: #60cdff;
    color: #202020;
}
QHeaderView::section {
    background-color: #2e2e2e;
    color: #9a9a9a;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    padding: 8px;
    font-weight: bold;
}
QTableCornerButton::section { background-color: #2e2e2e; }
/* ---- 文本框 ---- */
QPlainTextEdit {
    background-color: #1b1b1b;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    color: #8bc34a;
    font-family: "Cascadia Code", "DejaVu Sans Mono", "Noto Sans Mono CJK SC", monospace;
    font-size: 12px;
    padding: 6px;
    selection-background-color: #60cdff;
    selection-color: #202020;
}
QPlainTextEdit:focus { border-color: #60cdff; }
/* ---- 滚动条 ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #4a4a4a;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #5a5a5a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #4a4a4a;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover { background: #5a5a5a; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
/* ---- 提示 ---- */
QToolTip {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 10px;
}
/* ---- 列表 ---- */
QListWidget {
    background-color: #1b1b1b;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    color: #ffffff;
}
QListWidget::item { padding: 7px 10px; border-radius: 5px; }
QListWidget::item:selected {
    background-color: #60cdff;
    color: #202020;
}
QListWidget::item:hover { background-color: rgba(255, 255, 255, 0.1); }
/* ---- 分割器 ---- */
QSplitter::handle {
    background-color: #2a2a2a;
}
QSplitter::handle:hover { background-color: #60cdff; }
QSplitter::handle:vertical { height: 4px; }
QSplitter::handle:horizontal { width: 4px; }
/* ---- 标签页 ---- */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    top: -1px;
    background-color: #202020;
}
QTabBar::tab {
    background-color: #2b2b2b;
    color: #9a9a9a;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    padding: 9px 20px;
    margin-right: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:hover { background-color: #333333; color: #ffffff; }
QTabBar::tab:selected {
    background-color: #202020;
    color: #60cdff;
    font-weight: bold;
    border-bottom: 2px solid #60cdff;
}
/* ---- 下拉框 ---- */
QComboBox {
    background-color: #2b2b2b;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 7px 12px;
    color: #ffffff;
}
QComboBox:hover { border-color: #555555; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    border: 1px solid #3c3c3c;
    selection-background-color: #60cdff;
    selection-color: #202020;
    color: #ffffff;
    outline: none;
    padding: 4px;
}
/* ---- 进度条 ---- */
QProgressBar {
    background-color: #2b2b2b;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    text-align: center;
    color: #9a9a9a;
    font-size: 11px;
}
QProgressBar::chunk {
    background-color: #60cdff;
    border-radius: 4px;
}
/* ---- 树形控件 ---- */
QTreeWidget {
    background-color: #242424;
    alternate-background-color: #282828;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
    color: #ffffff;
}
QTreeWidget::item { padding: 6px; border-radius: 4px; }
QTreeWidget::item:selected { background-color: #60cdff; color: #202020; }
QTreeWidget::item:hover { background-color: rgba(255, 255, 255, 0.1); }
QTreeWidget::branch { background: transparent; }
/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #2b2b2b;
    color: #9a9a9a;
    border-top: 1px solid #3c3c3c;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #9a9a9a; padding: 0 8px; }
/* ---- 菜单 ---- */
QMenuBar {
    background-color: #202020;
    color: #ffffff;
}
QMenuBar::item:selected { background-color: rgba(255, 255, 255, 0.1); border-radius: 4px; }
QMenu {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { padding: 6px 24px; border-radius: 4px; }
QMenu::item:selected { background-color: rgba(255, 255, 255, 0.1); }
/* ---- 复选框 ---- */
QCheckBox { spacing: 6px; }
QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    border: 1px solid #555555;
    background-color: #2b2b2b;
}
QCheckBox::indicator:hover { border-color: #60cdff; }
QCheckBox::indicator:checked {
    background-color: #60cdff;
    border-color: #60cdff;
}
/* ---- Dock ---- */
QDockWidget { color: #ffffff; font-weight: bold; }
QDockWidget::title {
    background-color: #2b2b2b;
    padding: 6px;
    border: 1px solid #3c3c3c;
}
